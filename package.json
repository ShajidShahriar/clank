{
  "name": "clank",
  "private": true,
  "version": "0.0.1",
  "description": "Clank — a coding agent desktop app",
  "author": "Clank",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build:backend": "uv run python backend/scripts/freeze_backend.py",
    "build": "npm run build:backend && tsc -b && vite build && electron-builder",
    "preview": "vite preview",
    "test:electron": "node --test \"electron/backend/*.test.ts\"",
    "test:ui": "node --test \"src/api/*.test.ts\" \"src/lib/*.test.ts\"",
    "test:js": "npm run test:electron && npm run test:ui"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0"
  }
}
